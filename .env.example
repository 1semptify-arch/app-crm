# Copy this file to .env.local and fill in your Supabase project values
# to enable cloud sync. Leave it absent (or values empty) to run in
# local demo mode — the app stores data in your browser only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google OAuth2 client ID for "save to your Google Drive" mode.
# Data lives in the USER's Drive (hidden appDataFolder), never on our
# servers. Ignored when the Supabase vars above are set. See README →
# "Save to your Google Drive (OAuth2)" for the Google Cloud setup steps.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: URL that returns a JSON array of inbound mail messages
# [{ "id": "...", "from": "Name <addr>", "subject": "...", "body": "...",
#    "date": "<ISO>" }]. When set, the "smart brain" email plugin registers
# itself and a "Sync inbox" button appears on the Log view.
# VITE_CRM_INBOUND_MAIL_URL=http://localhost:8788/inbound.json
